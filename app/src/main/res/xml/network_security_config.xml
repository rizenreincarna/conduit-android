<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Android cannot express private IP ranges here. ConnectionURLPolicy gates
         each request/redirect before a transport is allowed to use cleartext. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors><certificates src="system" /></trust-anchors>
    </base-config>
</network-security-config>
